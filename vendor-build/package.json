{
  "name": "rust-wasm-serve-vendor",
  "private": true,
  "description": "Builds web/vendor/codemirror.js. Run: npm ci && npm run build",
  "scripts": {
    "build": "esbuild codemirror-entry.js --bundle --format=esm --minify --outfile=../web/vendor/codemirror.js && node collect-licenses.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.14",
    "codemirror": "^6.0.1"
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  }
}
